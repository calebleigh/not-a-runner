<?xml version="1.0" encoding="utf-8"?>
<!-- The workout notification: an orange card with the app's drifting stripes, the
     activity icon, the clock, distance / pace / steps, and a Pause / Resume button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nw_card"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:background="@drawable/notif_card"
    android:clipToOutline="true">

    <!-- An endless "progress bar" is the one thing a notification animates: it runs the stripes. -->
    <ProgressBar
        android:id="@+id/nw_stripes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="true"
        android:indeterminateOnly="false"
        android:indeterminateDrawable="@drawable/notif_stripes_anim"
        android:indeterminateTint="#FF000000"
        android:maxHeight="1000dp"
        android:maxWidth="2000dp"
        android:minHeight="0dp"
        android:minWidth="0dp" />

    <ImageView
        android:id="@+id/nw_stripes_still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/notif_stripes"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/nw_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/notif_tile"
            android:padding="9dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nw_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:textColor="#B8141210"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/nw_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:textColor="#141210"
                android:textSize="36sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/nw_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D9141210"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/nw_btn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_btn"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_pause"
            android:tint="#FF6A13" />
    </LinearLayout>
</FrameLayout>
