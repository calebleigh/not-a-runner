<?xml version="1.0" encoding="utf-8"?>
<!-- The workout notification (collapsed): a card in the theme's accent with the app's drifting stripes, the
     activity icon, the clock, distance / pace / steps, and a Pause / Resume button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nw_card"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@drawable/notif_card_clip"
    android:clipToOutline="true">

    <!-- The theme's accent (tinted in code), then a light-to-dark wash for its gradient. -->
    <ImageView
        android:id="@+id/nw_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/notif_card" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/notif_card_shade" />

    <!-- An endless "progress bar" is the one thing a notification animates: it runs the stripes. -->
    <ProgressBar
        android:id="@+id/nw_stripes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="true"
        android:indeterminateOnly="false"
        android:indeterminateDrawable="@drawable/notif_stripes_small_anim"
        android:indeterminateTint="#FF000000"
        android:maxHeight="1000dp"
        android:maxWidth="2000dp"
        android:minHeight="0dp"
        android:minWidth="0dp" />

    <ImageView
        android:id="@+id/nw_stripes_still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/notif_stripes_small"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <ImageView
            android:id="@+id/nw_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/notif_tile"
            android:padding="5dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/nw_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:textColor="#141210"
                android:textSize="18sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/nw_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#D9141210"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/nw_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_btn"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_pause" />
    </LinearLayout>
</FrameLayout>
